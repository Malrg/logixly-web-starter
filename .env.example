# Copia este archivo como .env.local para desarrollo local.
# Nunca subas .env ni .env.local al repositorio (ya están en .gitignore).

# Obligatoria: API key de Resend (Dashboard de Resend -> API Keys).
# El endpoint src/app/api/contact/route.ts la usa en servidor para enviar el
# formulario de contacto por email. NO lleva el prefijo NEXT_PUBLIC_: nunca
# se envía al navegador.
RESEND_API_KEY=

# Opcional. Remitente ("From") del email de contacto, formato
# "Nombre <email@dominio>". Si se deja vacío, se usa por defecto el dominio
# de pruebas de Resend: "Logixly Studio <onboarding@resend.dev>", que solo
# puede enviar a la dirección con la que se creó la cuenta de Resend. En
# cuanto haya un dominio verificado en Resend (ver README/instrucciones de
# despliegue), se rellena aquí con el remitente definitivo, por ejemplo:
# RESEND_FROM_EMAIL="Logixly Studio <hola@logixlystudio.com>"
RESEND_FROM_EMAIL=

# NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
